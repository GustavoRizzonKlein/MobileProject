<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.trabalhofinal.ui.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.trabalhofinal.ui.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.trabalhofinal.ui.RegisterFragment"
        android:label="Cadastro"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.trabalhofinal.ui.HomeFragment"
        android:label="MedCare"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_addMedication"
            app:destination="@id/addMedicationFragment" />
        <action
            android:id="@+id/action_home_to_history"
            app:destination="@id/historyFragment" />
        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_home_to_confirm"
            app:destination="@id/confirmMedicationFragment" />
    </fragment>

    <fragment
        android:id="@+id/confirmMedicationFragment"
        android:name="com.example.trabalhofinal.ui.ConfirmMedicationFragment"
        android:label="Confirmar Dose"
        tools:layout="@layout/fragment_confirm_medication">
        <argument
            android:name="medicationId"
            app:argType="integer" />
        <argument
            android:name="medicationName"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/addMedicationFragment"
        android:name="com.example.trabalhofinal.ui.AddMedicationFragment"
        android:label="Adicionar Medicamento"
        tools:layout="@layout/fragment_add_medication" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.trabalhofinal.ui.HistoryFragment"
        android:label="Histórico"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.trabalhofinal.ui.ProfileFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_profile" />

</navigation>